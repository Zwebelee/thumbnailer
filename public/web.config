<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: works at the site root or in any subfolder / virtual directory -->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- older IIS versions do not serve .json by default; remove first to avoid duplicate errors -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
  <!-- always fetch the latest index.html so new deployments show up immediately (hashed assets can be cached) -->
  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Cache-Control" value="no-cache" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
